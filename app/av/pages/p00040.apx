page 40 (
    name: Visibility
    title: Visibility
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region condition-details (
        name: Condition Details
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.application_id || ' - '  || v.application_name app
                      ,v.visibility_name
                      ,v.visibility_category
                      ,v.visibility_type
                      ,v.visibility_exp1
                      ,count(1) amount
                      ,visibility_type || '<br>amount=' || count(1) || '<br>' || visibility_exp1 tooltip
                from av_visibility_v v
                where v.visibility_name is not null
                and v.application_id = :P0_APP_ID or :P0_APP_ID is null
                group by v.application_id || ' - '  || v.application_name
                        ,v.visibility_category
                        ,v.visibility_name
                        ,visibility_type
                        ,visibility_exp1
                
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        dataCursor {
            dimOnHover: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: APP
                label: VISIBILITY_NAME
                value: AMOUNT
                customTooltip: TOOLTIP
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region conditioned-by (
        name: Conditioned by
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.application_id
                      ,v.visibility_category
                      ,count(1) amount
                from av_visibility_v v
                where v.visibility_name is not null and (v.application_id = :P0_APP_ID or :P0_APP_ID is null)
                group by application_id, visibility_category
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: pie
        }
        dataCursor {
            dimOnHover: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: APPLICATION_ID
                label: VISIBILITY_CATEGORY
                value: AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    region objects-conditioned (
        name: Objects conditioned
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(1) amount_overall
                      ,v.application_id
                      ,v.component_type
                      ,(select count (1) from av_visibility_v v1 where v1.application_id = v.application_id and v1.component_type = v.component_type and v1.visibility_name is not null group by v1.component_type,v1.application_id) amount
                from av_visibility_v v
                where v.application_id = :P0_APP_ID or :P0_APP_ID is null
                group by application_id, component_type
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: funnel
        }
        dataCursor {
            dimOnHover: false
        }
        value {
            format: decimal
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: APPLICATION_ID
                label: COMPONENT_TYPE
                value: AMOUNT
                targetValue: AMOUNT_OVERALL
            }
            label {
                show: true
            }
        )

    )

    dynamicAction change-p0-app-id (
        name: change P0_APP_ID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P0_APP_ID
        }

        action native-hide (
            action: hide
            affectedElements {
                selectionType: region
                region: @condition-details
            }
            execution {
                sequence: 10
                fireWhenEventResultIs: false
            }
        )

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @objects-conditioned
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @conditioned-by
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @condition-details
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @conditioned-by
            }
            execution {
                sequence: 20
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-refresh-5 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @objects-conditioned
            }
            execution {
                sequence: 30
                fireWhenEventResultIs: false
                fireOnInit: false
            }
        )

        action native-show (
            action: show
            affectedElements {
                selectionType: region
                region: @condition-details
            }
            execution {
                sequence: 10
            }
        )

    )

)

