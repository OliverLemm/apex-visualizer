page 708 (
    name: APEX 21.2
    alias: APEX-21-2
    title: APEX 21.2
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region 5-1-1-deprecated-page-positions (
        name: "5.1.1 Deprecated Page Positions "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id, page_name, region_name, display_position_code
                from apex_application_page_regions r
                where display_position_code in ( 'BODY_1', 'BODY_2', 'BODY_3', 'AFTER_HEADER', 'BEFORE_FOOTER' )
                and application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 20
            parentRegion: @5-1-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-21-2-htmrn-index-html-htmrn-guid-657ff369-756e-4f31-96f9-b2d92c3de084-target-blank-link-to-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: The following page positions are marked as deprecated and display as "Legacy" in Page Designer: Body 1, Body 2, Body 3, After Header, Before Footer
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no Deprecated Page Positions used</b>
        }

        column DISPLAY_POSITION_CODE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Display Position Code
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column REGION_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Region Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 2
            }
        )

    )

    region 5-1-2-deprecated-region-positions (
        name: 5.1.2 Deprecated Region Positions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.page_id
                      ,b.page_name
                      ,b.region
                      ,b.button_name
                      ,b.label
                      ,b.display_position
                from apex_application_page_buttons b
                where b.display_position_code in ('TOP'
                                                 ,'BOTTOM'
                                                 ,'BELOW_BOX'
                                                 ,'ABOVE_BOX')
                and b.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 30
            parentRegion: @5-1-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-21-2-htmrn-index-html-htmrn-guid-657ff369-756e-4f31-96f9-b2d92c3de084-target-blank-link-to-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The following region positions are marked as deprecated and display as "Legacy" in Page Designer: Top, Bottom, Above and Below (used for button positioning within a region)
                
                
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no Deprecated Region Positions used</b>
        }

        column BUTTON_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Button Name
                alignment: center
            }
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 3
            }
        )

        column DISPLAY_POSITION (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Display Position
                alignment: center
            }
            layout {
                sequence: 60
            }
        )

        column LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Label
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column REGION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Region
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 2
            }
        )

    )

    region 5-1-3-custom-page-region-templates-with-duplicated-positions-deprecated (
        name: 5.1.3 Custom Page Region Templates with Duplicated Positions Deprecated
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @5-1-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-21-2-htmrn-index-html-htmrn-guid-657ff369-756e-4f31-96f9-b2d92c3de084-target-blank-link-to-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                Custom page template and custom region templates with duplicated positions are considered deprecated. For example, a region template referencing position #CHANGE# twice is not recommended because that duplicate position causes duplicate DOM IDs.<br>
                <br>
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 5-1-4-legacy-substitution-strings-deprecated (
        name: "5.1.4 Legacy Substitution Strings Deprecated "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id
                      ,page_name
                      ,component_name
                      ,component_type
                      ,code_vc2
                from av_p0708_legacy_subst_strings_v
                where application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 50
            parentRegion: @5-1-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-21-2-htmrn-index-html-htmrn-guid-657ff369-756e-4f31-96f9-b2d92c3de084-target-blank-link-to-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                As of this release, the following apex.env substitution strings are deprecated and considered legacy: <b>APP_IMAGES, IMAGE_PREFIX, THEME_DB_IMAGES, THEME_IMAGES, WORKSPACE_IMAGES</b><br>
                While the legacy substitutions still function, Oracle recommends developers update their environments to use updated substitutions (listed below).
                <ul>
                    <li>IMAGE_PREFIX => APEX_FILES</li>
                    <li>WORKSPACE_IMAGES => WORKSPACE_FILES</li>
                    <li>APP_IMAGES => APP_FILES</li>
                    <li>THEME_IMAGES => THEME_FILES</li>
                    <li>THEME_DB_IMAGES => THEME_DB_FILES</li>
                </ul>
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no Legacy Substitution Strings Deprecated used</b>
        }

        column CODE_VC2 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Code Vc2
                alignment: center
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                highlightWords: IMAGE_PREFIX,WORKSPACE_IMAGES,APP_IMAGES,THEME_IMAGES,THEME_DB_IMAGES
            }
        )

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 3
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 2
            }
        )

    )

    region 5-1-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-21-2-htmrn-index-html-htmrn-guid-657ff369-756e-4f31-96f9-b2d92c3de084-target-blank-link-to-release-notes-a (
        name: 5.1 Deprecated Features - <a href="https://docs.oracle.com/en/database/oracle/application-express/21.2/htmrn/index.html#HTMRN-GUID-657FF369-756E-4F31-96F9-B2D92C3DE084" target="_blank">Link to Release Notes</a>
