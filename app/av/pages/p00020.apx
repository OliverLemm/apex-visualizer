            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column PAGE_TEMPLATE (
            type: plainText
            heading {
                heading: Template
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column RELOAD_ON_SUBMIT (
            type: plainText
            heading {
                heading: Reload On Submit
            }
            layout {
                sequence: 140
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: N
            }
        )

        column WARN_ON_UNSAVED_CHANGES (
            type: plainText
            heading {
                heading: Warn On Unsaved Changes
            }
            layout {
                sequence: 150
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: O
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Pages
        }

        savedReport 206792 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn APPLICATION_ID (
                sequence: 1
            )

            displayColumn APPLICATION_NAME (
                sequence: 2
            )

            displayColumn CREATED_BY (
                sequence: 10
            )

            displayColumn CREATED_ON (
                sequence: 11
            )

            displayColumn LAST_UPDATED_BY (
                sequence: 12
            )

            displayColumn LAST_UPDATED_ON (
                sequence: 13
            )

            displayColumn PAGE_ALIAS (
                sequence: 6
            )

            displayColumn PAGE_FUNCTION (
                sequence: 7
            )

            displayColumn PAGE_GROUP (
                sequence: 8
            )

            displayColumn PAGE_ID (
                sequence: 3
            )

            displayColumn PAGE_MODE (
                sequence: 5
            )

            displayColumn PAGE_NAME (
                sequence: 4
            )

            displayColumn PAGE_TEMPLATE (
                sequence: 9
            )

            displayColumn RELOAD_ON_SUBMIT (
                sequence: 14
            )

            displayColumn WARN_ON_UNSAVED_CHANGES (
                sequence: 15
            )

        )

    )

    dynamicAction change-p0-items (
        name: change P0_ITEMS
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P0_APP_ID
                P0_PAGE_ID
                P0_COMPONENT
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pages
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @components-overall
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @components-per-page
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @number-of-components-per-page
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

