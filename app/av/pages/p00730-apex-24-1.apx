page 730 (
    name: APEX 24.1
    alias: APEX-24-1
    title: APEX 24.1
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region 5-1-deprecated-apis (
        name: 5.1 Deprecated APIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(lower(p.plsql_code_clob)
                        ,'approval') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_javascript.add_3rd_party_library_file') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_css.add_3rd_party_library_file') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_util.url_encode') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_plugin_util.print_display_only') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_automation.abort') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The <b>APEX_APPROVAL</b> package is deprecated. Use APEX_HUMAN_TASK instead.<br>
                The PL/SQL APIs <b>apex_javascript.add_3rd_party_library_file</b> and <b>apex_css.add_3rd_party_library_file</b> are deprecated and will be removed in a future APEX release.<br>
                The <b>URL_ENCODE</b> function in <b>APEX_UTIL/</b> is now deprecated. Instead, use the built-in database function UTL_URL.ESCAPE.<br>
                The <b>apex_plugin_util.print_display_only</b> API is deprecated. Instead, use apex_plugin_util.print_read_only.<br>
                The <b>ABORT</b> function in <b>APEX_AUTOMATION</b> is now deprecated. Instead, use TERMINATE to terminate a currently executing automation.<br>
                Oracle recommends not relying on APEX's 3rd party dependencies as they may change without notice. Instead, bundle your own dependencies or include them via a CDN.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated API calls found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PLSQL_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Plsql Code Clob
                alignment: center
            }
            layout {
                sequence: 60
            }
        )

        column PROCESS_POINT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Process Point
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

    )

    region 5-2-deprecated-dynamic-action-event (
        name: 5.2 Deprecated Dynamic Action Event
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.page_id
                      ,d.page_name
                      ,'dynamic action' component_type
                      ,d.dynamic_action_name
                      ,d.when_event_name
                from apex_application_page_da d
                where d.application_id = :P0_APP_ID
                and d.when_event_name = 'Page Unload'
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 20
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: The APEX Dynamic Action event "Page Unload" is deprecated because the underlying browser event unload is deprecated. For more information, see Window: unload event.
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No Page Unload found.</b>
        }

        column COMPONENT_TYPE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column DYNAMIC_ACTION_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Dynamic Action Name
            }
            layout {
                sequence: 50
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column WHEN_EVENT_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: When Event Name
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: Page Unload
            }
        )

    )

    region 5-3-deprecated-plugin-attribute (
        name: 5.3 Deprecated Plugin Attribute
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.plugin_type, p.display_name, p.substitute_attributes
                from apex_appl_plugins p
                where p.plugin_type = 'Region Type'
                and p.application_id = :P0_APP_ID
                and p.substitute_attributes = 'Y'
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 30
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: When editing a region plug-in, the Substitute Attribute Values switch is now deprecated. When you move to the Procedure interface, this switch disappears. To perform substitutions on the attribute value, use apex_plugin_util.replace_substitutions.
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated Plugin Attribute found.</b>
        }

        column DISPLAY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Display Name
            }
            layout {
                sequence: 20
            }
        )

        column PLUGIN_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Plugin Type
            }
            layout {
                sequence: 10
            }
        )

        column SUBSTITUTE_ATTRIBUTES (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Substitute Attributes
            }
            layout {
                sequence: 30
            }
        )

    )

    region 5-4-number-field-substitutions (
        name: 5.4 Number Field Substitutions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id, p.page_name, p.display_as, p.item_name, p.label, p.attribute_01 item_min, p.attribute_02 item_max
                from apex_application_page_items p
                where display_as_code = 'NATIVE_NUMBER_FIELD'
                and p.application_id = :P0_APP_ID
                and (instr(p.attribute_01,'&') > 0 or instr(p.attribute_02,'&') > 0)
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 40
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: Dynamic substitutions for Min/Max Value attributes for the Number field page item, including &P1_MIN., are deprecated. This will be fixed in a future release by allowing developers to declaratively pick an item to use for Min/Max Value attributes.
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated Field Substitution in Number Fields found.</b>
        }

        column DISPLAY_AS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Display As
            }
            layout {
                sequence: 30
            }
        )

        column ITEM_MAX (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Item Max
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                highlightWords: &
            }
        )

        column ITEM_MIN (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Item Min
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: &
            }
        )

        column ITEM_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Item Name
            }
            layout {
                sequence: 40
            }
        )

        column LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Label
            }
            layout {
                sequence: 50
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
            }
            layout {
                sequence: 20
            }
        )

    )

    region 5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a (
        name: 5 Deprecated Features - <a href="https://docs.oracle.com/en/database/oracle/apex/24.1/htmrn/deprecated-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region 7-1-removed-json-application-export (
        name: 7.1 Removed JSON Application Export
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: [
                av-no-check-needed
                av-developer-functionality
            ]
        }
        advanced {
            htmlDomId: av-region-desupported-71
        }
        headerAndFooter {
            headerText:
                ```html
                The JSON application export option is removed. The Export Readable Format option is now a switch. If off, the application exports in SQL form. If on, the export file contains a human-readable YAML version of the application metadata.<br>
                <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> nothing to change / no check needed</b>
                ```
        }
    )

    region 7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a (
        name: 7 Desupported Features - <a href="https://docs.oracle.com/en/database/oracle/apex/24.1/htmrn/desupported-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-refresh-regions (
        name: click refresh - refresh regions
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction page-load-add-icons-by-class (
        name: page load - add icons by class
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log('running DA')
                    console.log(this.affectedElements);
                    ```
            }
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: .av-no-check-needed,.av-developer-functionality
            }
            execution {
                sequence: 10
            }
        )

    )

)

