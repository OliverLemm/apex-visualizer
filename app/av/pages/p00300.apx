page 300 (
    name: PLSQL
    title: PLSQL
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: unrestricted
    }

    region characters-of-plsql-code-per-page (
        name: Characters of PLSQL Code per Page
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id,
                  page_name_and_id,
                  page_group,
                  page_function,
                  components_count,
                  code_length_sum,
                  code_lines_sum,
                  tooltip
                from av_p0300_plsql_code_by_page_v t
                where (t.application_id = :P0_APP_ID or :P0_APP_ID is null)
                and t.page_id is not null
                and (:P0_BEST_PRACTICE = -1 or :P0_BEST_PRACTICE = t.best_practice)
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_BEST_PRACTICE
            ]
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 9
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: bubble
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: PAGE_GROUP
                label: PAGE_NAME_AND_ID
                x: COMPONENTS_COUNT
                y: CODE_LINES_SUM
                z: CODE_LENGTH_SUM
                customTooltip: TOOLTIP
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s("P0_PAGE_ID",'&PAGE_ID.');
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            title: number of plsql components
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: code lines
            value {
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region place-of-plsql (
        name: Place of PLSQL
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select application_name
                      ,application_id
                      ,component_type || ' - ' || code_type component
                      ,sum(code_length) amount
                from av_plsql_v
                where (:P0_APP_ID is null or application_id = :P0_APP_ID)
                and (:P0_PAGE_ID is null or page_id = :P0_PAGE_ID)
                and (:P0_BEST_PRACTICE = -1 or :P0_BEST_PRACTICE = best_practice)
                group by application_name,application_id,component_type || ' - ' || code_type
                order by sum(code_length) desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
                P0_BEST_PRACTICE
            ]
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDataChange: none
        }
        legend {
            position: bottom
        }

        series place-of-plsql (
            name: Place of PLSQL
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: APPLICATION_NAME
                label: COMPONENT
                value: AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    region plsql-in-page (
        name: PLSQL in Page
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select component_type || ' - ' || v.component_name series_name, v.component_type, v.plsql_code, v.code_length, v.code_type, v.tooltip, v.page_designer_url
                from av_plsql_v v
                where v.application_id = :P0_APP_ID 
                and (v.page_id = :P0_PAGE_ID)
                and (:P0_BEST_PRACTICE = -1 or :P0_BEST_PRACTICE = v.best_practice)
                and (v.component_type = :P300_COMPONENT_TYPE or :P300_COMPONENT_TYPE is null)
                order by code_length desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
                P0_BEST_PRACTICE
                P300_COMPONENT_TYPE
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 350
        }
        performance {
            lazyLoading: true
        }
        dataCursor {
            dimOnHover: false
        }

        series plsql-in-page (
            name: PLSQL in Page
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: SERIES_NAME
                label: COMPONENT_TYPE
                value: CODE_LENGTH
                customTooltip: TOOLTIP
            }
            link {
                type: redirectUrl
                targetUrl: &PAGE_DESIGNER_URL.
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            value {
                scale: log
            }
            minorTicks {
                show: false
            }
        )

    )

    pageItem P300_COMPONENT_TYPE (
        type: selectList
        label {
            label: Component type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct component_type d, component_type r
                from av_plsql_v
                where (:P0_APP_ID is null or application_id = :P0_APP_ID)
                and (:P0_PAGE_ID is null or page_id = :P0_PAGE_ID)
                
                ```
            displayExtraValues: false
            nullDisplayValue: all
        }
        cascadingLov {
            parentItems: [
                P0_APP_ID
                P0_PAGE_ID
            ]
            itemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
            ]
            parentRequired: false
        }
        layout {
            sequence: 200
            region: @/filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction change-p0-app-id (
        name: Change P0_APP_ID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P0_APP_ID
                P0_PAGE_ID
                P0_BEST_PRACTICE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @characters-of-plsql-code-per-page
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @place-of-plsql
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @plsql-in-page
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction change-p300-component-type (
        name: Change P300_COMPONENT_TYPE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P300_COMPONENT_TYPE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @plsql-in-page
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

