page 60 (
    name: Templates
    title: Templates
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region details (
        name: Details
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select th.application_id
                      ,th.application_name
                      ,th.theme_name
                      ,th.default_nav_list_position nav_pos
                      ,th.default_page_template page_temp
                      ,th.default_region_template region_temp
                      ,th.default_report_region_template rep_region_temp
                      ,th.default_button_template button_temp
                      ,th.icon_library      
                from apex_application_themes th
                where th.application_id = :P0_APP_ID or :P0_APP_ID is null
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: details
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                html
                pdf
                excel
            ]
        }
        advanced {
            savedReportMappingIdentifier: 162641779883396011
        }

        savedReport 1256361 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
