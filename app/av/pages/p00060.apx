        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region templates-reference-customized (
        name: Templates Reference (customized)
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.template_type || ' - ' || t.template_name template
                      ,case t.is_subscribed when 'No' then 'New defined Template' else 'Original Template' end new_or_original
                      ,t.reference_count
                      ,'Default=' || t.is_default || '<br>Last Updated =' || t.last_updated_by || ' - ' || t.last_updated_on tooltip
                from apex_application_templates t
                join apex_application_themes th on th.theme_number = t.theme_number
                                            and th.application_id = t.application_id
                where t.is_subscribed = 'No'
                and th.application_id = :P0_APP_ID
                and t.reference_count > 0
                and (:P60_TEMPLATE_TYPE is null or :P60_TEMPLATE_TYPE = template_type)
                order by template_type, reference_count desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P60_TEMPLATE_TYPE
            ]
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 600
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: Please select an Application
        }

        series customized (
            name: Customized
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: TEMPLATE
                value: REFERENCE_COUNT
                customTooltip: TOOLTIP
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region templates-reference-overall (
        name: Templates Reference (overall)
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.template_type || ' - ' || t.template_name template
                      ,case t.is_subscribed when 'No' then 'New defined Template' else 'Original Template' end new_or_original
                      ,t.reference_count
                      ,'Default=' || t.is_default || '<br>Subscribed =' || t.is_subscribed tooltip
                from apex_application_templates t
                join apex_application_themes th on th.theme_number = t.theme_number
                                            and th.application_id = t.application_id
                where th.is_current = 'Yes'
                and t.reference_count > 0
                and th.application_id = :P0_APP_ID
                and (:P60_TEMPLATE_TYPE is null or :P60_TEMPLATE_TYPE = template_type)
                order by template_type, reference_count desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P60_TEMPLATE_TYPE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartAppearance {
            orientation: horizontal
        }
        chartLayout {
            height: 600
        }
        dataCursor {
            dimOnHover: false
        }
        legend {
            show: false
        }
        messages {
            whenNoDataFound: Please select an Application
        }

        series template-reference (
            name: Template Reference
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                label: TEMPLATE
                value: REFERENCE_COUNT
                customTooltip: TOOLTIP
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            value {
                scale: log
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    pageItem P60_TEMPLATE_TYPE (
        type: selectList
        label {
            label: Template type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select distinct template_type d, template_type r from apex_application_templates where reference_count > 0 and application_id = :P0_APP_ID
            displayExtraValues: false
            nullDisplayValue: all
        }
        cascadingLov {
            parentItems: P0_APP_ID
        }
        layout {
            sequence: 40
            region: @/filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction change-p0-app-id (
        name: Change P0_APP_ID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @details
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @templates-reference-overall
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @templates-reference-customized
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction change-p60-template-type (
        name: Change P60_TEMPLATE_TYPE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P60_TEMPLATE_TYPE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @templates-reference-overall
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @templates-reference-customized
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)

