page 740 (
    name: APEX 24.2
    alias: APEX-24-2
    title: APEX 24.2
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region 5-1-deprecated-apis (
        name: 5.1 Deprecated APIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(lower(p.plsql_code_clob)
                        ,'apex_lang.message') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_plugin_util.execute_plsql_code') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_util.custom_calendar') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_util.increment_calendar') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-deprecated-51
        }
        headerAndFooter {
            headerText:
                ```html
                <h4>APEX_LANG</h4>
                <b>APEX_LANG.MESSAGE</b> is deprecated. Instead, use APEX_LANG.GET_MESSAGE to support named substitution parameters.<br>
                <h4>APEX_PLUGIN_UTIL</h4>
                <b>APEX_PLUGIN_UTIL.EXECUTE_PLSQL_CODE</b> is now deprecated. Instead, use APEX_EXEC.EXECUTE_PLSQL Signature 1 or Signature 2.<br>
                <h4>APEX_UTIL</h4>
                <b>APEX_UTIL.CUSTOM_CALENDAR</b> and <b>APEX_UTIL.INCREMENT_CALENDAR</b> are deprecated.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated API calls found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PLSQL_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Plsql Code Clob
                alignment: center
            }
            layout {
                sequence: 60
            }
        )

        column PROCESS_POINT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Process Point
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

    )

