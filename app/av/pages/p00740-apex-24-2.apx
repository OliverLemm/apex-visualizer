    region 7-2-public-dictionary-view-changes (
        name: 7.2 Public Dictionary View Changes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(lower(p.plsql_code_clob)
                        ,'apex_application_page_items') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_appl_page_ig_columns') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_appl_plugin_settings') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'apex_appl_page_filters') > 0)
                and (instr(lower(p.plsql_code_clob)
                        ,'attribute_01') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_02') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_03') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_04') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_05') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_06') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_07') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_08') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_09') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_10') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_11') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_12') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_13') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_14') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_15') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_16') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_17') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_18') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_19') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_20') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_21') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_22') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_23') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_24') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'attribute_25') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 20
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-desupported-72
        }
        headerAndFooter {
            headerText:
                ```html
                As of APEX 24.2, columns attribute_01 through attribute_25 now return null in the following views:<br>
                <b>apex_application_page_items, apex_appl_page_ig_columns, apex_appl_plugin_settings, apex_appl_page_filters</b><br>
                You can query this attributes by reading the attribute's JSON column. See 
                <a href="https://docs.oracle.com/en/database/oracle/apex/24.2/htmrn/new-features.html#GUID-D165A54A-FA88-4BDD-B948-B9BB235FA1D6" target="_bank">Unlimited Attributes for Item Plug-ins</a>.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No API calls <b>apex_application_page_items, apex_appl_page_ig_columns, apex_appl_plugin_settings, apex_appl_page_filters</b> with attribute_01 to 25 found.</b>
        }

