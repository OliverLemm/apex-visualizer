    region 7-1-desupported-apis (
        name: 7.1 Desupported APIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.page_id
                      ,j.page_name
                      ,j.component_name
                      ,j.component_type
                      ,j.js_code_vc2
                from av_javascript_v j
                where (instr(lower(j.js_code_clob)
                           ,'apex_javascript.add_3rd_party_library_file') > 0
                       or
                       instr(lower(j.js_code_clob)
                           ,'apex_css.add_3rd_party_library_file') > 0
                      )
                and j.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-desupported-71
        }
        headerAndFooter {
            headerText:
                ```html
                As of APEX 24.2, the following APIs are desupported:<br>
                <b>apex_javascript.add_3rd_party_library_file, apex_css.add_3rd_party_library_file</b>
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No calls like apex_javascript.add_3rd_party_library_file or apex_css.add_3rd_party_library_file found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column JS_CODE_VC2 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Js Code Vc2
                alignment: center
