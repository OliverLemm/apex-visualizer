    region 7-3-tinymce-based-rich-text-editor-desupported (
        name: 7.3 TinyMCE-based Rich Text Editor Desupported
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.page_id
                      ,i.page_name
                      ,i.region
                      ,i.label
                      ,i.init_javascript_code
                from apex_application_page_items i
                where i.display_as = 'Rich Text Editor'
                and i.init_javascript_code is not null
                and application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 30
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-desupported-73
        }
        headerAndFooter {
            headerText:
                ```html
                In APEX 24.1, the Rich Text Editor page item based on the TinyMCE library was deprecated.<br>
                As of APEX 24.2, TinyMCE is desupported and the Rich Text Editor page item no longer supports the TinyMCE library. The underlying library is now Oracle Rich Text Library (ORTL). Any Rich Text Editor page items still using TinyMCE are auto-migrated to ORTL. Any custom Initialization JavaScript Function code is commented out.<br>
                Rich Text Editor occurances with Init JavaScript Code are listed.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No Rich Text Editors with Init JavaScript code have been found.</b>
        }

        column INIT_JAVASCRIPT_CODE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Init Javascript Code
            }
            layout {
                sequence: 50
            }
        )

        column LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Label
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column REGION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Region
            }
            layout {
                sequence: 30
            }
        )

    )

    region 7-4-csso-desupported (
        name: 7.4 CSSO Desupported
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-desupported-74
        }
        headerAndFooter {
            headerText:
                ```html
                The CSSO 3rd party JavaScript library is removed from APEX, and replaced with a basic minification logic. This may impact existing CSS static files.<br>
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a (
        name: 7 Desupported Features - <a href="https://docs.oracle.com/en/database/oracle/apex/24.2/htmrn/desupported-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-refresh-regions (
        name: click refresh - refresh regions
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction page-load-add-icons-by-class (
        name: page load - add icons by class
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log('running DA')
                    console.log(this.affectedElements);
                    ```
            }
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: .av-no-check-needed,.av-developer-functionality
            }
            execution {
                sequence: 10
            }
        )

    )

)

