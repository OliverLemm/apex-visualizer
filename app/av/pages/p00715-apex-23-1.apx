    region 5-1-ckeditor5-deprecated (
        name: 5.1 CKEditor5 Deprecated
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.region
                      ,p.item_name
                      ,p.label
                from apex_application_page_items p
                where p.display_as_code = ('NATIVE_RICH_TEXT_EDITOR')
                and p.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-1-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: CKEditor5 is deprecated. Existing items based on the CKEditor5 library continue to work. However, these items will be automatically converted to TinyMCE in a future release. Any custom code using CKEditor5 APIs must be re-worked.
        }
