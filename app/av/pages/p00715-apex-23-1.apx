            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no JET or old Datepicker are used</b>
        }

