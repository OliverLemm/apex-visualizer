    region 7-4-dom-object-desupported (
        name: 7.4 DOM Object Desupported
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aap.page_id
                      ,aap.page_name
                      ,aap.dynamic_action_name
                from apex_application_page_da aap
                where aap.application_id = :P0_APP_ID
                and aap.when_selection_type_code = 'DOM' -- not correct must be changed
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 40
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The DOM Object Dynamic Action selector type is desupported. Any page that uses this type for an action now throws an exception in the browser console, and the action does not execute.<br>
                Use the JavaScript Expression type instead of DOM Object.
                
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> check needs to be implemented</b>
        }

        column DYNAMIC_ACTION_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Dynamic Action Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

    )

    region 7-5-legacy-bulk-utilities-desupported (
        name: "7.5 Legacy Bulk Utilities Desupported "
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The Grid Edit tools are now desupported. This includes grid edit tools available in:<br>
                <ul>
                <li>Cross Page Utilities</li>
                <li>Region Utilities</li>
                <li>Button Utilities</li>
                <li>Item Utilities</li>
                <li>Computation Utilities</li>
                <li>Validation Utilities</li>
                <li>Process Utilities</li>
                <li>Dynamic Action Utilities</li>
                <li>Branch Utilities</li>
                </ul>
                You can edit items individually through Page Designer, or view them in bulk through the appropriate Utility area.<br> 
                <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no check needed / developer utilities</b>
                ```
        }
    )

    region 7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a (
        name: 7 Desupported Features - <a href="https://docs.oracle.com/en/database/oracle/apex/23.1/htmrn/desupported-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-refresh-regions (
        name: click refresh - refresh regions
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction page-load-add-icons-by-class (
        name: page load - add icons by class
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log('running DA')
                    console.log(this.affectedElements);
                    ```
            }
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: .av-no-check-needed,.av-developer-functionality
            }
            execution {
                sequence: 10
            }
        )

    )

)

