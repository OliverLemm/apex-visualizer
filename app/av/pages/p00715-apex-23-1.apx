    region 7-2-desupported-user-interfaces-removed (
        name: 7.2 Desupported User Interfaces Removed
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(upper(p.plsql_code_clob)
                        ,'APEX_WORKSPACE_UI_TYPES') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_APPL_USER_INTERFACES') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'ui_detection_css_urls') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'user_interface_id') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'page_transition') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'popup_transition') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'ui_type_id') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'ui_type_name') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'default_page_transition') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'default_popup_transition') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'supported_ui_types') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'supported_ui_types') > 0 or
                     instr(lower(p.plsql_code_clob)
                        ,'supported_ui_types') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 20
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                APEX previously defined multiple users interfaces for each application. This is no longer the case. This release cleans up desupported user interfaces, which impacts many APEX Dictionary Views:<br>
                Obsolete views:<br>
                <ul><li>apex_workspace_ui_types</li>
                    <li>apex_appl_user_interfaces</li>
                </ul>
                Multiple columns are also desupported. For details look into the release notes.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no APEX Views or columns which are removed are used</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
            sorting {
                defaultSequence: 1
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PLSQL_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Plsql Code Clob
