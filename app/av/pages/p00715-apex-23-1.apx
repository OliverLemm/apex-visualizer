            }
            layout {
                sequence: 60
            }
        )

        column PROCESS_POINT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Process Point
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

    )

    region 7-3-desupported-jet-date-picker-item-type-migrated (
        name: 7.3 Desupported JET Date Picker Item Type Migrated
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.region
                      ,p.item_name
                      ,p.label
                      ,case p.display_as_code when 'NATIVE_DATE_PICKER_JET' then 'JET Datepicker' else 'jQuery Datepicker' end display_as
                from apex_application_page_items p
                where p.display_as_code in ('NATIVE_DATE_PICKER_JET','NATIVE_DATE_PICKER')
                and p.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 30
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-1-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The Date Picker (JET) item type is now removed. Existing page items and interactive grid columns are automatically migrated to the new Date Picker item type introduced in APEX 22.2.<br>
                This impacts any JavaScript customizations made for the JET Date Picker component.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
