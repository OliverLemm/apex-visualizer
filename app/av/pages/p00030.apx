page 30 (
    name: Page
    title: Page
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
    }
    security {
        formAutoComplete: false
    }

    region page (
        name: Page
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aap.application_id
                      ,aap.application_name
                      ,aap.page_id
                      ,aap.page_name
                      ,aap.page_mode
                      ,aap.page_alias
                      ,aap.page_function
                      ,aap.page_group
                      ,aap.page_template
                      ,aap.created_by
                      ,aap.created_on
                      ,aap.last_updated_by
                      ,aap.last_updated_on
                      ,aap.reload_on_submit
                      ,aap.warn_on_unsaved_changes
                from apex_application_pages aap
                where (aap.application_id = :P0_APP_ID or :P0_APP_ID is null)
                and (aap.page_id = :P0_PAGE_ID or :P0_PAGE_ID is null)
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            showTotalCount: false
        }
        toolbar {
            show: false
        }
        enableUsersTo {
            download: false
        }
        heading {
            fixedTo: none
        }
        advanced {
            savedReportMappingIdentifier: 161725872973543908
        }

        savedReport 1256357 (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APPLICATION_ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @APPLICATION_NAME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @PAGE_ID
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @PAGE_NAME
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @PAGE_MODE
                layout {
                    sequence: 5
                }
            )

            displayColumn (
                column: @PAGE_ALIAS
                layout {
                    sequence: 6
                }
            )

            displayColumn (
                column: @PAGE_FUNCTION
                layout {
                    sequence: 7
                }
            )

            displayColumn (
                column: @PAGE_GROUP
                layout {
                    sequence: 8
                }
            )

            displayColumn (
                column: @PAGE_TEMPLATE
                layout {
                    sequence: 9
                }
            )

            displayColumn (
                column: @CREATED_BY
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @CREATED_ON
                layout {
                    sequence: 11
                }
            )

            displayColumn (
                column: @LAST_UPDATED_BY
                layout {
                    sequence: 12
                }
            )

            displayColumn (
                column: @LAST_UPDATED_ON
                layout {
                    sequence: 13
                }
            )

            displayColumn (
                column: @RELOAD_ON_SUBMIT
                layout {
                    sequence: 14
                }
            )

            displayColumn (
                column: @WARN_ON_UNSAVED_CHANGES
                layout {
                    sequence: 15
                }
            )

        )

        column APPLICATION_ID (
            type: numberField
            heading {
                heading: Application id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: APPLICATION_ID
                dataType: number
            }
            columnFilter {
                lovType: none
            }
        )

        column APPLICATION_NAME (
            type: textarea
            heading {
                heading: Application name
            }
            layout {
                sequence: 20
            }
            validation {
                valueRequired: true
                maxLength: 255
            }
            source {
                databaseColumn: APPLICATION_NAME
                dataType: varchar2
            }
            columnFilter {
                performanceImpactingOperators: [
                    contains
                    startsWith
                    caseInsensitive
                    regexp
                ]
                lovType: none
            }
            enableUsersTo {
                sort: false
            }
        )

        column CREATED_BY (
            type: textarea
            heading {
