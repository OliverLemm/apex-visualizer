    dynamicAction change-p0-items (
        name: change P0_ITEMS
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P0_APP_ID
                P0_PAGE_ID
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @page
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

