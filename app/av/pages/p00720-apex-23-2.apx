page 720 (
    name: APEX 23.2
    alias: APEX-23-2
    title: APEX 23.2
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region 5-1-quick-sql-deprecated-functionality (
        name: 5.1 Quick SQL Deprecated Functionality
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <b>Deprecated Settings</b><br/>
                The following Quick SQL settings are deprecated:<br/>
                Data Language (<i>#language:"DE"</i>): No longer generates sample data into different languages (German, Korean, Japanese, Spanish).<br/>
                Tags Framework (<i>#tags:true</i>): No longer generates tag framework objects (table, trigger, sync procedure).<br/>
                On Delete (<i>#ondelete:"cascade"</i>): No longer supports system-wide ondelete settings. Handle these settings through the new /cascade column directive.<br/>
                Longer Varchar2 (<i>#longVC:true</i>): No longer supports artificially shortening or increasing VARCHAR2 size.<br/>
                Tenant ID (<i>#tenantID:true</i>): No longer supported.<br/>
                <br/>
                <b>Deprecated Directives</b><br/>
                The following Quick SQL directives are deprecated:<br/>
                <i>/select</i>: No longer generates a SQL SELECT statement after generating data for each table.<br/>
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a (
        name: 5 Deprecated Features - <a href="https://docs.oracle.com/en/database/oracle/apex/23.2/htmrn/deprecated-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region 7-1-desupported-utilities (
        name: "7.1 Desupported Utilities "
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
            cssClasses: [
                av-no-check-needed
                av-developer-functionality
            ]
        }
        advanced {
            htmlDomId: av-region-desupported-71
        }
        headerAndFooter {
            headerText:
                ```html
                The APEXExport utility is desupported and is no longer included with Oracle APEX. Oracle recommends using SQLcl to perform export operations.<br>
                <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> nothing to change / no check needed</b>
                ```
        }
    )

    region 7-2-querying-template-component-metadata (
        name: 7.2 Querying Template Component Metadata
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.page_id
                      ,r.page_name
                      ,r.region_name
                from apex_application_page_regions r
                where r.application_id = :P0_APP_ID
                and r.template_component_type_code is not null
                and (r.attribute_01 is not null or --
                      r.attribute_02 is not null or --
                      r.attribute_03 is not null or --
                      r.attribute_04 is not null or --
                      r.attribute_05 is not null or --
                      r.attribute_06 is not null or --
                      r.attribute_07 is not null or --  
                      r.attribute_08 is not null or --
                      r.attribute_09 is not null or --  
                      r.attribute_10 is not null or --
                      r.attribute_11 is not null or --
                      r.attribute_12 is not null or --
                      r.attribute_13 is not null or --
                      r.attribute_14 is not null or --
                      r.attribute_15 is not null or --
                      r.attribute_16 is not null or --
                      r.attribute_17 is not null or --  
                      r.attribute_18 is not null or --
                      r.attribute_19 is not null or --  
                      r.attribute_20 is not null or --
                      r.attribute_21 is not null or --
                      r.attribute_22 is not null or --
                      r.attribute_23 is not null or --
                      r.attribute_24 is not null or --
                      r.attribute_25 is not null)
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 20
            parentRegion: @7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-232-desup-72
        }
        headerAndFooter {
            headerText:
                ```html
                For template components only, the ATTRIBUTE_01...ATTRIBUTE_25 columns of APEX_APPLICATION_PAGE_REGIONS and APEX_APPLICATION_PAGE_IR_COL public views now return null.<br />
                Instead, use the new ATTRIBUTES column that stores a JSON object of all attribute values. Use the attribute's Static ID as the object key. Note that a table alias is always needed when using the JSON dot notation.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no Template Component with old Metadata used</b>
        }

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
            }
            layout {
                sequence: 20
            }
        )

        column REGION_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Region Name
            }
            layout {
                sequence: 30
            }
        )

    )

    region 7-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-23-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a (
        name: 7 Desupported Features - <a href="https://docs.oracle.com/en/database/oracle/apex/23.2/htmrn/desupported-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-refresh-regions (
        name: click refresh - refresh regions
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction page-load-add-icons-by-class (
        name: page load - add icons by class
        execution {
            sequence: 30
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    console.log('running DA')
                    console.log(this.affectedElements);
                    ```
            }
            affectedElements {
                selectionType: jquerySelector
                jquerySelector: .av-no-check-needed,.av-developer-functionality
            }
            execution {
                sequence: 10
            }
        )

    )

)

