    region 8-1-7-show-hide-all-page-items-on-same-line-attributes-desupported (
        name: "8.1.7 Show / Hide All Page Items On Same Line Attributes Desupported "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.page_id
                      ,d.page_name
                      ,d.dynamic_action_name
                      ,d.affected_elements
                from apex_application_page_da_acts d
                where d.affected_elements_type_code = 'ITEM'
                and d.action_code in ('NATIVE_SHOW'
                                    ,'NATIVE_HIDE')
                and d.attribute_01 = 'Y'
                and d.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 70
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-1-htmrn-index-html-htmrn-guid-4bcd1a37-908c-4770-8c3c-2f4f721e74a7-target-blank-link-to-release-notes-a
