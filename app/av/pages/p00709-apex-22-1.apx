    region 6-1-2-deprecated-javascript-apis (
        name: 6.1.2 Deprecated JavaScript APIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.page_id
                      ,j.page_name
                      ,j.component_name
                      ,j.component_type
                      ,j.js_code_vc2
                from av_javascript_v j
                where (instr(lower(j.js_code_clob)
                           ,'useIconList') > 0 or
                       instr(lower(j.js_code_clob)
                           ,'iconListOptions') > 0)
                and j.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
