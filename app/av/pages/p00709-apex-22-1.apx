    region 8-1-13-syntax-column-name-label-in-interactive-grid-icon-and-detail-views-desupported (
        name: "8.1.13 Syntax {COLUMN_NAME}_LABEL in Interactive Grid Icon and Detail Views Desupported"
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id
                      ,page_name
                      ,region_name
                      ,icon_view_custom
                      ,detail_view_for_each_row
                from apex_appl_page_igs
                where application_id = :P0_APP_ID
                and (regexp_like(icon_view_custom
                               ,'&' || '\w+_LABEL\.'
                               ,'i') or --
                      regexp_like(detail_view_for_each_row
                               ,'&' || '\w+_LABEL\.'
                               ,'i'))
                ```
            pageItemsToSubmit: P0_APP_ID
        }
