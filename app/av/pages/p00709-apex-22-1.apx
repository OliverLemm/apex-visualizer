    region 6-1-1-deprecated-apis (
        name: "6.1.1 Deprecated APIs "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and instr(upper(p.plsql_code_clob)
                        ,'APEX_IR.GET_REPORT') > 0
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 10
            parentRegion: @6-1-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-1-htmrn-index-html-htmrn-guid-657ff369-756e-4f31-96f9-b2d92c3de084-target-blank-link-to-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: The <b>APEX_IR.GET_REPORT</b> API is deprecated. Instead, use <b>APEX_REGION.OPEN_QUERY_CONTEXT</b> to get interactive report data.
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no APEX_IR.GET_REPORT used</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
