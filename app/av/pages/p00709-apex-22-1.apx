            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P0_APP_ID
                P0_PAGE_ID
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-refresh-regions (
        name: click refresh - refresh regions
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

