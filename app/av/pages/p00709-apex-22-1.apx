    region 8-1-4-legacy-substitution-strings-desupported (
        name: 8.1.4 Legacy Substitution Strings Desupported
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id
                      ,page_name
                      ,component_name
                      ,component_type
                      ,code_vc2
                from av_p0708_legacy_subst_strings_v
                where application_id = :P0_APP_ID
                ```
