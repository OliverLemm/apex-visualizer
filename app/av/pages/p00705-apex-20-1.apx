    region 6-1-10-apexrefresh-event-is-deprecated (
        name: 6.1.10 apexrefresh Event is Deprecated
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.page_id
                      ,j.page_name
                      ,j.component_name
                      ,j.component_type
                      ,j.js_code_vc2
                from av_javascript_v j
                where regexp_like(j.js_code_vc2
                                 ,'apex.event.trigger.*apexrefresh'
                                 ,'i')
                and j.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
