page 660 (
    name: Migration Effort
    alias: MIGRATION-EFFORT
    title: Migration Effort
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    css {
        inline:
            ```css
            td[headers=MIGRATION_PRIORITY],
            td[headers=RN_CHAPTER_NAME]
            {
              white-space: nowrap;
            }
            ```
    }

    region migration-effort (
        name: Migration Effort
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                 apex_version
                ,rn_type
                ,rn_chapter_no
                ,rn_chapter_name
                ,rn_chapter_text
                ,migration_priority
                ,count(1) amount_of_objects
                ,round(sum(migration_effort_in_days)
                      ,3) migration_effort_in_days
                from av_migration_pkg.ptf_effort_calculation(i_app_id               => :P0_APP_ID
                                                            ,i_apex_versions        => :P660_APEX_VERSIONS
                                                            ,i_migration_priorities => :P660_MIGRATION_PRIORITIES)
                  group by apex_version
                          ,rn_type
                          ,rn_chapter_no
                          ,rn_chapter_name
                          ,rn_chapter_text
                          ,migration_priority
                  order by migration_priority
                          ,replace(rn_chapter_no,'.','')
                          ,rn_type
                          ,apex_version
                          
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P660_APEX_VERSIONS
                P660_MIGRATION_PRIORITIES
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: showAll
        }
        performance {
            lazyLoading: true
        }
        breakFormatting {
            breakColumns: col1
        }

        column AMOUNT_OF_OBJECTS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: # Objects
                alignment: end
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column APEX_VERSION (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: APEX Version
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column MIGRATION_EFFORT_IN_DAYS (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Effort In Days
                alignment: end
            }
            layout {
                sequence: 80
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990D00
            }
            sorting {
                sortable: false
            }
            advanced {
                computeSum: true
            }
        )

        column MIGRATION_PRIORITY (
            reportColumnQueryId: 6
            derivedColumn: N
            type: plainTextBasedOnLov
            heading {
                heading: Priority
                alignment: end
            }
            lov {
                type: sharedComponent
                lov: @migration-priority
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            sorting {
                sortable: false
            }
        )

        column RN_CHAPTER_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Chapter Name
            }
            layout {
                sequence: 50
            }
            sorting {
                sortable: false
            }
        )

        column RN_CHAPTER_NO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Chapter No
            }
            layout {
                sequence: 40
            }
            sorting {
                sortable: false
            }
        )

        column RN_CHAPTER_TEXT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Description
            }
            layout {
                sequence: 60
            }
            sorting {
                sortable: false
            }
        )

        column RN_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

    )

    pageItem P660_APEX_VERSIONS (
        type: checkboxGroup
        label {
            label: APEX Versions
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @apex-versions
            displayExtraValues: false
        }
        layout {
            sequence: 50
            region: @/filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
    )

    pageItem P660_MIGRATION_PRIORITIES (
        type: checkboxGroup
        label {
            label: Migration Priorities
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @migration-priority
            displayExtraValues: false
        }
        layout {
            sequence: 60
            region: @/filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        help {
            helpText:
                ```html
                1 - must<br>without these changes application will crash or doesn't work<br><br>
                2 - should<br>with these changes application gets minimum changes to run in latest APEX release<br><br>
                3 - recommed<br>mostly desupported and deprecated features that should be adjusted<br><br>
                4 - best practices<br>only adjustments which will reduce effort for maintaining in future or would be faster
                ```
        }
    )

    dynamicAction click-refresh-refresh-region-migration-effort (
        name: click Refresh - Refresh Region Migration Effort
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @migration-effort
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

