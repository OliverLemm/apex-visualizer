        layout {
            sequence: 30
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The following columns are marked as desupported in the <b>apex_applications</b> view: <b>app_builder_icon_name, favicons, pwa_manifest_icon_url</b>.
                
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no Desupported View Columns used</b>
        }

        column APP_BUILDER_ICON_NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: App Builder Icon Name
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column FAVICONS (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Favicons
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PWA_MANIFEST_ICON_URL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Pwa Manifest Icon Url
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

    )

    region 8-1-4-fullcalendar-3-desupported (
        name: 8.1.4 FullCalendar 3 Desupported
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                FullCalendar v3 is desupported, including:<br>
                - deprecated plug-in attributes<br>
                - files and folders specific to v3 or jquery-fullcalendar<br>
                - v3-specific logic in PL/SQL and JavaScript<br>
                <br>
                The used library version is now FullCalendar 5.11.2. APEX upgrades the library automatically.<br> 
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 8-1-5-app-builder-defaults-desupported (
        name: 8.1.5 App Builder Defaults Desupported
        type: staticContent
        layout {
            sequence: 50
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                Developers can no longer define App Builder Defaults from Workspace Utilities, App Builder Defaults. The Create Application Wizard no longer uses the defined attributes.<br> 
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 8-1-6-copying-legacy-themes-desupported (
        name: 8.1.6 Copying Legacy Themes Desupported
        type: staticContent
        layout {
            sequence: 60
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                The Copy Theme Wizard no longer supports copying legacy themes. This includes Themes 1 - 26, and the jQuery Mobile theme.<br>
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 8-1-7-ckeditor4-desupported (
        name: 8.1.7 CKEditor4 Desupported
        type: staticContent
        layout {
            sequence: 70
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                Rich Text Editor items based on CKEditor4, which are marked as deprecated since APEX 20.2, are now desupported and will be automatically converted to CKEditor5. CKEditor4 is removed from APEX completely.<br>
                Converted items receive the following configuration:
                <br>
                - Format: HTML<br>
                - Toolbar: unchanged<br>
                - Toolbar Style: Multiline<br>
                - Minimum Height: 180<br>
                - Maximum Height: null<br>
                - Allow Custom HTML: Enabled<br>
                <br>
                The properties Toolbar Position and Skin do not have a CKEditor5 equivalent, and are removed. Any code included in the JavaScript Initialization Code attribute is automatically commented out.<br>
                Oracle recommends manually checking the functioning of each Rich Text Editor item.<br>
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> no check integrated</b>
                ```
        }
    )

    region 8-1-8-desupported-public-package-apis (
        name: 8.1.8 Desupported Public Package APIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(upper(p.plsql_code_clob)
                        ,'APEX_PAGE.IS_DESKTOP_UI') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_PAGE.GET_UI_TYPE') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 80
            parentRegion: @8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: The APIs functions <b>apex_page.is_desktop_ui function</b> and <b>apex_page.get_ui_type</b> are desupported.
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> no API calls used</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PLSQL_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Plsql Code Clob
                alignment: center
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: APEX_PAGE.IS_DESKTOP_UI,APEX_PAGE.GET_UI_TYPE
            }
        )

        column PROCESS_POINT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Process Point
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

    )

    region 8-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-apex-22-2-htmrn-desupported-features-html-target-blank-link-to-release-notes-a (
        name: 8.1 Desupported Features - <a href="https://docs.oracle.com/en/database/oracle/apex/22.2/htmrn/desupported-features.html" target="_blank">Link to Release Notes</a>
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-refresh-regions (
        name: click refresh - refresh regions
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: av_refresh_hide_show_regions()
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

