    region 6-1-3-deprecated-apis-and-parameters-javascript-api (
        name: "6.1.3 Deprecated APIs and Parameters (JavaScript API) "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.page_id
                      ,j.page_name
                      ,j.component_name
                      ,j.component_type
                      ,j.js_code_vc2
                from av_javascript_v j
                where instr(lower(j.js_code_clob)
                           ,'apex.pwa.gettnstalltext') > 0
                and j.application_id = :P0_APP_ID
                ```
