    region 7-1-11-apex-navigation-dialog-fireclosehandler-function-is-desupported (
        name: 7.1.11 apex.navigation.dialog.fireCloseHandler function is Desupported
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.page_id
                      ,j.page_name
                      ,j.component_name
                      ,j.component_type
                      ,j.js_code_vc2
                from av_javascript_v j
                where instr(j.js_code_clob
                           ,'apex.navigation.dialog.fireCloseHandler') > 0
                and j.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 50
            parentRegion: @7-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-21-1-htmrn-index-html-htmrn-guid-cc4b5d70-22fd-45ca-8f6f-c34a91f1b5bd-target-blank-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No calls like apex.navigation.dialog.fireCloseHandler found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column JS_CODE_VC2 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Js Code Vc2
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

    )

