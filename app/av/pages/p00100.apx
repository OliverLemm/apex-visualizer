page 100 (
    name: JavaScript
    title: JavaScript
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region characters-of-javascript-code-per-page (
        name: Characters of JavaScript Code per Page
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select application_name, t.page_id,page_name || ' (' || page_id || ')'  page_name, sum(t.js_code_length) js_code_length
                from av_javascript_v t
                where t.application_id = :P0_APP_ID or :P0_APP_ID is null
                group by application_id, application_name , page_id, page_name
                order by sum(t.js_code_length) desc
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        config {
            buildOption: @deactivated
        }
        dataCursor {
            dimOnHover: false
        }

        series js-code-overall (
            name: JS Code Overall
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: APPLICATION_NAME
                label: PAGE_NAME
                value: JS_CODE_LENGTH
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region characters-of-javascript-code-per-page-2 (
        name: Characters of JavaScript Code per Page
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_id
                      ,page_name_and_id
                      ,page_group
                      ,page_function
                      ,components_count
                      ,code_length_sum
                      ,code_lines_sum
                      ,tooltip
                from av_p0100_js_code_by_page_v t
                where (t.application_id = :p0_app_id or :p0_app_id is null)
                and t.page_id is not null
                and (:p0_best_practice = -1 or :p0_best_practice = t.best_practice)
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_BEST_PRACTICE
            ]
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 9
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: bubble
        }
        chartLayout {
            height: 400
        }
        legend {
            show: false
        }

        series series (
            name: Series 1
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: PAGE_GROUP
                label: PAGE_NAME_AND_ID
                x: COMPONENTS_COUNT
                y: CODE_LINES_SUM
                z: CODE_LENGTH_SUM
                customTooltip: TOOLTIP
            }
            link {
                type: redirectUrl
                targetUrl: javascript:$s("P0_PAGE_ID",'&PAGE_ID.');
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            title: number of javascript components
            value {
                min: 0
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: code lines
            value {
                min: 0
                format: decimal
                decimalPlaces: 0
                formatScaling: none
            }
            minorTicks {
                show: false
            }
        )

    )

    region javascript-in-page (
        name: JavaScript in Page
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select page_name || ' (' || v.page_id || ') - ' || v.component_name series_name, 
                       v.component_type, 
                       v.js_code, 
                       v.js_code_length, 
                       v.js_code_type, 
                       v.tooltip, 
                       v.page_designer_url
                from av_javascript_v v
                where v.application_id = :P0_APP_ID 
                and (v.page_id = :P0_PAGE_ID or :P0_PAGE_ID is null)
                and (:P0_BEST_PRACTICE = -1 or :P0_BEST_PRACTICE = v.best_practice)
                and (v.component_type = :P100_COMPONENT_TYPE or :P100_COMPONENT_TYPE is null)
                order by js_code_length desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
                P0_BEST_PRACTICE
                P100_COMPONENT_TYPE
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chartLayout {
            height: 400
        }
        dataCursor {
            dimOnHover: false
        }

        series javascript-code (
            name: JavaScript Code
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: SERIES_NAME
                label: COMPONENT_TYPE
                value: JS_CODE_LENGTH
                customTooltip: TOOLTIP
            }
            link {
                type: redirectUrl
                targetUrl: &PAGE_DESIGNER_URL.
            }
            label {
                show: true
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region place-of-javascript (
        name: Place of JavaScript
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select application_name
                      ,application_id
                      ,component_type || ' - ' || js_code_type js_component
                      ,count(1) amount
                from av_javascript_v
                where (:P0_APP_ID is null or application_id = :P0_APP_ID)
                and (:P0_PAGE_ID is null or page_id = :P0_PAGE_ID)
                and (:P0_BEST_PRACTICE = -1 or :P0_BEST_PRACTICE = best_practice)
                group by application_name,application_id,component_type || ' - ' || js_code_type
                order by count(1) desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
                P0_BEST_PRACTICE
            ]
        }
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        chart {
            type: donut
        }
        chartLayout {
            height: 400
        }
        dataCursor {
            dimOnHover: false
        }
        animation {
            onDisplay: none
            onDataChange: none
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: APPLICATION_NAME
                label: JS_COMPONENT
                value: AMOUNT
            }
            label {
                show: true
                displayAs: percentage
            }
        )

    )

    pageItem P100_COMPONENT_TYPE (
        type: selectList
        label {
            label: Component type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct component_type d, component_type r
                from av_javascript_v
                where (:P0_APP_ID is null or application_id = :P0_APP_ID)
                and (:P0_PAGE_ID is null or page_id = :P0_PAGE_ID)
                
                ```
            displayExtraValues: false
            nullDisplayValue: all
        }
        cascadingLov {
            parentItems: [
                P0_APP_ID
                P0_PAGE_ID
            ]
            itemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
            ]
            parentRequired: false
        }
        layout {
            sequence: 40
            region: @/filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction change-component-type (
        name: change Component Type
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P100_COMPONENT_TYPE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @javascript-in-page
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction change-p0-items (
        name: change P0_ITEMS
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P0_APP_ID
                P0_PAGE_ID
                P0_BEST_PRACTICE
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @characters-of-javascript-code-per-page-2
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @place-of-javascript
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @javascript-in-page
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    dynamicAction click-refresh-button-refresh-regions (
        name: click refresh button - refresh regions
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @/refresh
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @characters-of-javascript-code-per-page
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @characters-of-javascript-code-per-page-2
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @javascript-in-page
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-4 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @place-of-javascript
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

)

