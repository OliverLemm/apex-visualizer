page 50 (
    name: Last Updated
    title: Last Updated
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        formAutoComplete: false
    }

    region application-changes (
        name: Application changes
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.application_id
                      ,l.application_name
                      ,l.audit_action
                      ,trunc(audit_date)
                      ,count(1) amount
                from apex_developer_activity_log l
                where (l.application_id = :P0_APP_ID or :P0_APP_ID is null)
                and l.page_id is not null
                and (l.page_id = :P0_PAGE_ID or :P0_PAGE_ID is null)
                group by trunc(audit_date), audit_action, application_name, application_id
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
            ]
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        dataCursor {
            dimOnHover: false
        }

        series last-updates (
            name: Last Updates
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: AUDIT_ACTION
                label: TRUNC(AUDIT_DATE)
                value: AMOUNT
            }
        )

        axis x (
            name: x
            value {
                format: dateShort
            }
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    region changes-on-components (
        name: Changes on Components
        type: chart
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.application_id
                      ,l.application_name
                      ,l.page_name
                      ,l.page_id
                      ,l.audit_action
                      ,l.component_name
                      ,l.component
                      ,trunc(audit_date)
                      ,count(1) amount
                      ,'page: ' || page_name || '<br>component name: ' || component_name || '<br>component type: ' || component tooltip
                from apex_developer_activity_log l
                where (l.application_id = :p0_app_id or :p0_app_id is null)
                and l.page_id is not null and component_name is not null
                and (l.page_id = :p0_page_id or :p0_page_id is null)
                and (trunc(audit_date) = to_date(:p50_date
                                               ,'dd.mm.yyyy') or :p50_date is null)
                group by trunc(audit_date)
                        ,audit_action
                        ,application_name
                        ,application_id
                        ,l.component_name
                        ,component
                        ,page_name
                        ,page_id
                order by count(1) desc
                ```
            pageItemsToSubmit: [
                P0_APP_ID
                P0_PAGE_ID
                P50_DATE
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        dataCursor {
            dimOnHover: false
        }

        series new (
            name: New
            execution {
                sequence: 10
            }
            source {
                location: regionSource
            }
            columnMapping {
                seriesName: COMPONENT
                label: COMPONENT_NAME
                value: AMOUNT
                customTooltip: TOOLTIP
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            minorTicks {
                show: false
            }
        )

    )

    pageItem P50_DATE (
        type: selectList
        label {
            label: Date
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(trunc(audit_date), 'dd.mm.yyyy') d, to_char(trunc(audit_date), 'dd.mm.yyyy') r
                from apex_developer_activity_log l
                where (l.application_id = :P0_APP_ID or :P0_APP_ID is null)
                and l.page_id is not null
                and (l.page_id = :P0_PAGE_ID or :P0_PAGE_ID is null)
                group by trunc(audit_date)
                ```
            displayExtraValues: false
            nullDisplayValue: all
        }
        layout {
            sequence: 40
            region: @/filter
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
            height: 1
        }
        security {
            encryptSessionState: false
        }
    )

    dynamicAction change-p0-app-id (
        name: change P0_APP_ID
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: [
                P0_APP_ID
                P0_PAGE_ID
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @application-changes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @changes-on-components
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction change-p50-date (
        name: change P50_DATE
        execution {
            sequence: 20
        }
        when {
            selectionType: items
            items: P50_DATE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @changes-on-components
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

