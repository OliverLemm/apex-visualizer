            headerText:
                ```html
                The ability to define REST APIs via the RESTful Services feature in SQL Workshop is deprecated with APEX 26.1, and will be removed in a future release of APEX. The declarative specification of REST APIs remains supported via SQL Developer Web.<br>
                <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> nothing to change / no check needed</b>
                ```
        }
    )

    region 5-8-deprecated-substitution-strings (
        name: "5.8 Deprecated Substitution Strings "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.component_type, 
                t.component_name, 
                t.template_clob1, 
                t.template_clob2, 
                t.template_clob3, 
                t.template_vc1, 
                t.template_vc2, 
                t.template_vc3
                from av_templates_v t
                where t.application_id = :P0_APP_ID 
                and (instr(upper(t.template_clob1)
                           ,'#REGION_STATIC_ID#') > 0
                or instr(upper(t.template_clob2)
                       ,'#REGION_STATIC_ID#') > 0
                or instr(upper(t.template_clob3)
                       ,'#REGION_STATIC_ID#') > 0
                or instr(upper(t.template_vc1)
                       ,'#REGION_STATIC_ID#') > 0
                or instr(upper(t.template_vc2)
                       ,'#REGION_STATIC_ID#') > 0
                or instr(upper(t.template_vc3)
                       ,'#REGION_STATIC_ID#') > 0
                or instr(upper(t.template_clob1)
                       ,'#BUTTON_ID#') > 0
                or instr(upper(t.template_clob2)
                       ,'#BUTTON_ID#') > 0
                or instr(upper(t.template_clob3)
                       ,'#BUTTON_ID#') > 0
                or instr(upper(t.template_vc1)
                       ,'#BUTTON_ID#') > 0
                or instr(upper(t.template_vc2)
                       ,'#BUTTON_ID#') > 0
                or instr(upper(t.template_vc3)
                       ,'#BUTTON_ID#') > 0
                or instr(upper(t.template_clob1)
                       ,'#APP_REGION_STATIC_ID#') > 0
                or instr(upper(t.template_clob2)
                       ,'#APP_REGION_STATIC_ID#') > 0
                or instr(upper(t.template_clob3)
                       ,'#APP_REGION_STATIC_ID#') > 0
                or instr(upper(t.template_vc1)
                       ,'#APP_REGION_STATIC_ID#') > 0
                or instr(upper(t.template_vc2)
                       ,'#APP_REGION_STATIC_ID#') > 0
                or instr(upper(t.template_vc3)
                       ,'#APP_REGION_STATIC_ID#') > 0)
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 100
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                As of this release, the following substitution strings are deprecated: <b>&#35;REGION_STATIC_ID#</b>, <b>#BUTTON_ID#</b>, <b>APP_REGION_STATIC_ID</b><br>
                While these substitutions still function, Oracle recommends developers update their environments to use the replacements below:<br>
                For &#35;REGION_STATIC_ID# and #BUTTON_ID#, use &#35;DOM_ID#<br>
                For APP_REGION_STATIC_ID, use APP_REGION_DOM_ID
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated Substitution Strings found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column TEMPLATE_CLOB1 (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Template Clob1
            }
            layout {
                sequence: 50
            }
            columnFormatting {
                highlightWords: #REGION_STATIC_ID#,#BUTTON_ID#,#APP_REGION_STATIC_ID#
            }
        )

        column TEMPLATE_CLOB2 (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Template Clob2
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: #REGION_STATIC_ID#,#BUTTON_ID#,#APP_REGION_STATIC_ID#
            }
        )

        column TEMPLATE_CLOB3 (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Template Clob3
            }
            layout {
                sequence: 70
            }
            columnFormatting {
                highlightWords: #REGION_STATIC_ID#,#BUTTON_ID#,#APP_REGION_STATIC_ID#
            }
        )

        column TEMPLATE_VC1 (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Template Vc1
            }
            layout {
                sequence: 80
            }
            columnFormatting {
                highlightWords: #REGION_STATIC_ID#,#BUTTON_ID#,#APP_REGION_STATIC_ID#
            }
        )

        column TEMPLATE_VC2 (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Template Vc2
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                highlightWords: #REGION_STATIC_ID#,#BUTTON_ID#,#APP_REGION_STATIC_ID#
            }
        )

        column TEMPLATE_VC3 (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Template Vc3
            }
            layout {
                sequence: 100
            }
            columnFormatting {
                highlightWords: #REGION_STATIC_ID#,#BUTTON_ID#,#APP_REGION_STATIC_ID#
            }
        )

    )

    region 5-9-deprecated-public-views-and-public-view-columns (
        name: "5.9 Deprecated Public Views and Public View Columns "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(lower(p.plsql_code_clob)
                        ,'apex_appl_ai_configs') > 0
                    or instr(lower(p.plsql_code_clob)
                        ,'apex_appl_ai_config_rag_srcs') > 0
                    or instr(lower(p.plsql_code_clob)
                        ,'ai_config_id') > 0
                    or instr(lower(p.plsql_code_clob)
                        ,'ai_config_name') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 120
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <h4>Public Views</h4>
                The <b>apex_appl_ai_configs</b> and <b>apex_appl_ai_config_rag_srcs</b> views are deprecated, and will be removed in a future release. Instead, use apex_appl_ai_agents and apex_appl_ai_agent_tools.
                <h4>AI Configuration Columns</h4>
                With the rename of AI Configurations to AI Agents, the <b>ai_config_id</b> and <b>ai_config_name</b> columns are deprecated, and will be removed in a future release. Instead, use ai_agent_id and ai_agent_name.<br>
                This change affects the following views: apex_application_page_items, apex_application_page_regions, apex_application_page_da_acts
                <h4>STATIC_ID Column</h4>
                The <b>STATIC_ID</b> column in the following public views is deprecated:
                apex_application_page_regions, apex_application_page_rpt_cols, apex_application_page_buttons, apex_application_page_ir_col, apex_appl_page_ig_columns<br>
                While APEX retains the STATIC_ID column for backward compatibility, Oracle recommends using the new HTML_DOM_ID column.
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> Column COMPONENT_SIGNATURE not used.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PLSQL_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Plsql Code Clob
                alignment: center
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: apex_appl_ai_configs,apex_appl_ai_config_rag_srcs,ai_config_id,ai_config_name
            }
        )

        column PROCESS_POINT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Process Point
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

    )

