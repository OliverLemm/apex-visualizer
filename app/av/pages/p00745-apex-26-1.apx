page 745 (
    name: APEX 26.1
    alias: APEX-26-1
    title: APEX 26.1
    appearance {
        pageTemplate: @/right-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }

    region 5-1 (
        name: 5.1 Cohere AI Models Deprecated
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select a.workspace, a.provider_type, model_name
                from apex_workspace_ai_services a
                where lower(a.model_name) in ('command-r-08-2024'
                                             ,'command-r-plus-08-2024'
                                             ,'command-latest'
                                             ,'command-plus-latest')
                ```
        }
        layout {
            sequence: 30
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                AI models <b>cohere.command-r-08-2024</b>, <b>cohere.command-r-plus-08-2024</b>, <b>cohere.command-latest</b> and <b>cohere.command-plus-latest</b> are now deprecated for AI Services based on the OCI Generative AI Service. Oracle recommends switching to cohere.command-a-03-2025, which also allows you to leverage tools, attachments, and more.</br>
                <b><span aria-hidden="true" class="fa fa-exclamation-circle u-warning-text"></span> This setting is on Workspace Level</b>
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated Cohere AI Models found.</b>
        }

        column MODEL_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Model Name
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                highlightWords: command-r-08-2024,command-r-plus-08-2024,command-latest,command-plus-latest
            }
        )

        column PROVIDER_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Provider Type
            }
            layout {
                sequence: 20
            }
        )

        column WORKSPACE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Workspace
            }
            layout {
                sequence: 10
            }
        )

    )

    region 5-1-deprecated-apis (
        name: 5.4 Deprecated PL/SQL APIs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.page_id
                      ,p.page_name
                      ,p.component_name
                      ,p.component_type
                      ,p.process_point
                      ,p.plsql_code_clob
                from av_plsql_v p
                where application_id = :P0_APP_ID
                and (instr(upper(p.plsql_code_clob)
                        ,'APEX_UTIL.CACHE_GET_DATE_OF_PAGE_CACHE') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_UTIL.CACHE_GET_DATE_OF_REGION_CACHE') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_UTIL.PUBLIC_CHECK_AUTHORIZATION') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_UTIL.PURGE_REGIONS_BY_NAME') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_UTIL.PURGE_REGIONS_BY_PAGE') > 0 or
                     instr(upper(p.plsql_code_clob)
                        ,'APEX_UTIL.PURGE_REGIONS_BY_APP') > 0
                    )
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 60
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: av-deprecated-51
        }
        headerAndFooter {
            headerText:
                ```html
                <h4>APEX_AI</h4>
                The following procedures are deprecated: <b>generate</b> Function Signature 3, <b>chat</b> Function Signature 3<br>
                Instead, use the two new signatures that contain a p_agent_static_id parameter instead of the deprecated p_config_static_id parameter.<br>
                <h4>APEX_PLUGIN</h4>
                The following fields in APEX_PLUGIN.T_REGION are deprecated: <b>static_id, filter_region_static_id</b><br>
                Use dom_id and filter_region_dom_id for new development. The name member of the APEX_PLUGIN.t_plugin record is deprecated. Use the new static_id member instead. <br>
                <h4>APEX_UTIL</h4>
                In APEX_UTIL, the following APIs are deprecated: <br>
                <b>CACHE_GET_DATE_OF_PAGE_CACHE Instead</b>, use APEX_PAGE.GET_CACHE_DATE<br>
                <b>CACHE_GET_DATE_OF_REGION_CACHE</b> Instead, use APEX_REGION.GET_CACHE_DATE<br>
                <b>PUBLIC_CHECK_AUTHORIZATION</b> Instead, use APEX_AUTHORIZATION.HAS_ACCESS<br>
                <b>PURGE_REGIONS_BY_NAME, PURGE_REGIONS_BY_PAGE, PURGE_REGIONS_BY_APP</b>
                ```
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated API calls found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column PAGE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Page Id
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

        column PAGE_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Page Name
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column PLSQL_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Plsql Code Clob
                alignment: center
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: apex_util.cache_get_date_of_page_cache,apex_util.cache_get_date_of_region_cache,apex_util.public_check_authorization,apex_util.purge_regions_by_name,apex_util.purge_regions_by_page,apex_util.purge_regions_by_app
            }
        )

        column PROCESS_POINT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Process Point
                alignment: center
            }
            layout {
                sequence: 50
            }
        )

    )

    region 5-2-legacy-calendar-templates-deprecated (
        name: "5.2 Legacy Calendar Templates Deprecated "
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.page_id
                      ,r.page_name
                      ,r.region_name
                      ,r.source_type
                      ,r.source_type_code
                from apex_application_page_regions r
                where source_type_code = 'CALENDAR'
                and r.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 40
            parentRegion: @5-deprecated-features-a-href-https-docs-oracle-com-en-database-oracle-apex-24-2-htmrn-deprecated-features-html-target-blank-link-to-release-notes-a
            slot: subRegions
