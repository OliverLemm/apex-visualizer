            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText: "Legacy Calendar Templates are now deprecated. The Legacy Calendar template is no longer present in Universal Theme 26.1, and APEXlang exports raise an error if Legacy Calendar regions are present. When upgrading your application, APEX automatically removes unreferenced Legacy Calendar Templates. "
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
