            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No deprecated API calls found.</b>
        }

        column COMPONENT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Component Name
                alignment: center
            }
            layout {
                sequence: 30
            }
        )

        column COMPONENT_TYPE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Component Type
                alignment: center
            }
            layout {
                sequence: 40
            }
        )

        column JS_CODE_CLOB (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Js Code Clob
            }
            layout {
                sequence: 60
            }
            columnFormatting {
                highlightWords: apex.util.cancelinvokeafterpaint,apex.util.invokeafterpaint,widget.grid.getselectedrange
            }
        )

        column JS_CODE_TYPE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Js Code Type
            }
            layout {
                sequence: 50
