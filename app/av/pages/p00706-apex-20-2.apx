        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    dynamicAction change-p0-app-id-refresh-regions (
        name: change P0_APP_ID - refresh regions
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P0_APP_ID
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @7-1-1-theme-style-vista-desupported-in-universal-theme
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
