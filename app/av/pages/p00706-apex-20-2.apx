    region 7-1-1-theme-style-vista-desupported-in-universal-theme (
        name: 7.1.1 Theme Style "Vista" Desupported in Universal Theme
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ts.name, is_current
                from apex_application_theme_styles ts
                where ts.application_id = :P0_APP_ID
                and ts.name = 'Vista'
                and ts.is_current = 'Yes'
                ```
            pageItemsToSubmit: P0_APP_ID
        }
        layout {
            sequence: 40
            parentRegion: @7-1-desupported-features-a-href-https-docs-oracle-com-en-database-oracle-application-express-20-2-htmrn-index-html-htmrn-guid-cc4b5d70-22fd-45ca-8f6f-c34a91f1b5bd-target-blank-release-notes-a
            slot: regionBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-expanded
                t-Region--scrollBody
            ]
        }
        reportLayout {
            numberOfRows: 99999
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
            displayPosition: topAndBottomRight
        }
        performance {
            lazyLoading: true
        }
        messages {
            whenNoDataFound: <b><span aria-hidden="true" class="fa fa-check-circle u-success-text"></span> No Theme Style Vista is used.</b>
        }

        column IS_CURRENT (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Is Current
                alignment: center
            }
            layout {
                sequence: 20
            }
        )

        column NAME (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Name
                alignment: center
            }
            layout {
                sequence: 10
            }
        )

    )

    region 7-1-13-desupported-javascript-functions (
        name: 7.1.13 Desupported JavaScript Functions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.page_id
                      ,j.page_name
                      ,j.component_name
                      ,j.component_type
                      ,j.js_code_vc2
                from av_javascript_v j
                where instr(j.js_code_clob
                           ,'.afterModify') > 0
                and j.application_id = :P0_APP_ID
                ```
            pageItemsToSubmit: P0_APP_ID
